<UserControl x:Class="GaussianTool.View.UserControls.OverviewTreeview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GaussianTool.View.UserControls"
             xmlns:fileHandling="clr-namespace:GaussianTool.Model.FileHandling"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38.2*"></ColumnDefinition>
            <ColumnDefinition Width="61.8*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <TreeView ItemsSource="{Binding RootNodes}" Foreground="Black" Margin="5"
                  FontSize="14" BorderBrush="Transparent">
            <TreeView.Resources>
        
                <HierarchicalDataTemplate DataType="{x:Type fileHandling:TreeNode}"
                                          ItemsSource="{Binding Children}">
        
                    <TextBlock Text="{Binding Name}"/>
        
                </HierarchicalDataTemplate>
        
            </TreeView.Resources>
        </TreeView>
        
    </Grid>
</UserControl>
