<UserControl x:Class="GaussianTool.View.UserControls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GaussianTool.View.UserControls"
             mc:Ignorable="d" Background="#323232" Foreground="White"
             d:DesignHeight="300" d:DesignWidth="300"
             Loaded="UserControl_Loaded">
    <UserControl.Effect>
        <DropShadowEffect
            Direction="180"
            ShadowDepth="3"
            BlurRadius="10">
        </DropShadowEffect>
    </UserControl.Effect>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Margin="5" HorizontalAlignment="Center" FontSize="14">
            Status
        </TextBlock>
        
        <!-- Main -->
        <ListView Grid.Row="1" Background="Transparent" BorderBrush="Transparent" 
                  BorderThickness="0" Foreground="White" Margin="5" SelectionMode="Single"
                  ItemsSource="{Binding JobsOnCluster}"
                  SelectedItem="{Binding SelectedCalcstatus}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0, 0, 0, 10"></Setter>
                </Style>
            </ListView.ItemContainerStyle>
            
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding JobName}"
                                   FontSize="14"/>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal">

                            <Ellipse Width="12"
                                     Height="12"
                                     Fill="{Binding LampColor}"
                                     Margin="0,0,8,0"/>

                            <TextBlock Text="{Binding JobState}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            
        </ListView>
        
        <!-- Bottom -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="5"/>
            <Button Content="Download" Command="{Binding DownloadCommand}" Margin="5"></Button>
        </StackPanel>
        
    </Grid>
</UserControl>
