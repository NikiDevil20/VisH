                    <RowDefinition Height="150"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                
                <!-- Header Image -->
                <Border Grid.Row="0" Margin="8" CornerRadius="2"
                        BorderThickness="3" BorderBrush="#006DB3" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Content="{Binding MoleculeName}" FontSize="18"
                               ></Label>
                        
                        <Image Grid.Row="1" x:Name="Molecule" Width="400" Stretch="Uniform" 
                               Source="{Binding MoleculeImage}"></Image>
                    </Grid>
                    
                </Border>
                
