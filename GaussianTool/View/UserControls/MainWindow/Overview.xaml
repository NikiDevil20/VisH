                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>


                                <!-- Frequencies -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                                    <TextBlock Text="Frequencies"
                                               FontWeight="Bold"
