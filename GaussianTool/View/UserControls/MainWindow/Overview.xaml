                        <Border Grid.Row="0" 
                            Margin="8,0,8,8" 
                            CornerRadius="2"
                            BorderThickness="3" 
                            BorderBrush="#006DB3">

                        <ScrollViewer Margin="5"
                                      Background="White"
                                      Padding="5"
                                      VerticalScrollBarVisibility="Auto">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- Metadata -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                                    <TextBlock Text="Metadata"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Margin="0,0,0,5"/>

                                    <ItemsControl ItemsSource="{Binding MetaDataGridItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="37*"/>
                                                        <ColumnDefinition Width="63*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Property}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>


                                <!-- Energies -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                                    <TextBlock Text="Energies"
                                               FontWeight="Bold"
