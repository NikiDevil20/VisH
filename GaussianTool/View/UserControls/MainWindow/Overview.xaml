<UserControl x:Class="GaussianTool.View.UserControls.Overview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GaussianTool.View.UserControls"
             xmlns:fileHandling="clr-namespace:GaussianTool.Model.FileHandling"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38.2*"></ColumnDefinition>
            <ColumnDefinition Width="61.8*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        
        <!-- Left Panel -->
        <Border Grid.Column="0" BorderBrush="#006DB3" BorderThickness="5" CornerRadius="2" Margin="20"
                Background="LightGray">
            <TreeView ItemsSource="{Binding RootNodes}" Foreground="Black" Margin="5"
                      FontSize="14" BorderBrush="Transparent" Background="Transparent" 
                      SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.Resources>
            
                    <HierarchicalDataTemplate DataType="{x:Type fileHandling:TreeNode}"
                                              ItemsSource="{Binding Children}">
            
                        <TextBlock Text="{Binding Name}"/>
            
                    </HierarchicalDataTemplate>
            
                </TreeView.Resources>
            </TreeView>
        </Border>
        
        <!-- Right Panel -->
        <Border Grid.Column="1" BorderBrush="#006DB3" BorderThickness="5" CornerRadius="2"
                Margin="0, 20, 20, 20" Background="LightGray">
