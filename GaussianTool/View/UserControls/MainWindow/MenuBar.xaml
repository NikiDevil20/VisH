<UserControl x:Class="GaussianTool.View.UserControls.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GaussianTool.View.UserControls" Background="#006DB3"
             mc:Ignorable="d" MouseLeftButtonDown="MenuBar_OnMouseLeftButtonDown"
             d:DesignHeight="70" d:DesignWidth="800">
    <UserControl.Effect>
        <DropShadowEffect
            Direction="270"
            ShadowDepth="3"
            BlurRadius="10">
        </DropShadowEffect>
    </UserControl.Effect>
    
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        
            
        <TextBlock Grid.Row="0" Grid.Column="0" Padding="20,5,0,0" HorizontalAlignment="Left"
                   VerticalAlignment="Center" Foreground="White" FontSize="32" FontFamily="Arial">
            <TextBlock.Text>
                Gaussian GUI
            </TextBlock.Text>
        </TextBlock>
        
        <Grid Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" Margin="15, 0, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Content="Settings" Margin="5" Padding="10, 2, 10, 2"></Button>
            
            <Button Grid.Column="1" Content="Help" Margin="5" Padding="10, 2, 10, 2"></Button>
            
            <Button Grid.Column="2" Command="{Binding DebugCommand}" Content="Debug" 
                    Margin="5" Padding="10, 2, 10, 2"></Button>
            
            <Button Grid.Column="3" Command="{Binding NewCalcCommand}" Content="New Calculation" 
                    Margin="5" Padding="10, 2, 10, 2"></Button>


            
        </Grid>
        
        
        <!-- Buttons Grid -->
        <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <Button Name="MinimizeBtn" Grid.Column="0" Content="__" Click="MinimizeBtn_OnClick" Margin="5"
                    Width="30" Height="30" FontSize="12" Foreground="White" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="0"></Button>
            
            <Button Name="MaximizeBtn" Grid.Column="1" Content="🗗" Click="MaximizeBtn_OnClick" Margin="5"
                    Width="30" Height="30" FontSize="12" Foreground="White" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="0"></Button>
            
            <Button Name="CloseBtn" Grid.Column="2" Content="X" Click="CloseBtn_OnClick" Margin="5"
                    Width="30" Height="30" FontSize="12" Foreground="White" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="0"></Button>
            
            
            
        </Grid>
            
            
    </Grid>
</UserControl>
