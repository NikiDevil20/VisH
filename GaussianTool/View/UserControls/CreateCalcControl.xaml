<UserControl x:Class="GaussianTool.View.UserControls.CreateCalcControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GaussianTool.View.UserControls"
             mc:Ignorable="d" Background="LightGray"
             d:DesignHeight="300" d:DesignWidth="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/><RowDefinition/>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <Label Grid.Row="0" Content="Create Calculation" FontSize="14"/>
        
        
        <!-- First Input -->
        <Grid Grid.Row="1">
            <local:CustomTextInput ></local:CustomTextInput>
        </Grid>
    </Grid>
        
    
</UserControl>
