<UserControl x:Class="GaussianTool.View.UserControls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GaussianTool.View.UserControls"
             mc:Ignorable="d" Background="#323232" Foreground="White"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Effect>
        <DropShadowEffect
            Direction="180"
            ShadowDepth="3"
            BlurRadius="10">
        </DropShadowEffect>
    </UserControl.Effect>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" FontSize="14" HorizontalAlignment="Center" Margin="5">
            Status
        </TextBlock>
        
        
    </Grid>
</UserControl>
