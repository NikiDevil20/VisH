<UserControl x:Class="GaussianTool.View.UserControls.NewCalculationWindow.MoleculeSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GaussianTool.View.UserControls.NewCalculationWindow"
             xmlns:userControls="clr-namespace:GaussianTool.View.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        
        <GroupBox Header="Coordinates" Margin="10" BorderBrush="#006DB3" BorderThickness="2" 
                  Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                
                
                <TextBlock Grid.Row="0" Text="Enter SMILES string:" Height="20"></TextBlock>
                <userControls:CustomTextInput Placeholder="Smiles" Text="{Binding SmilesEntry}" 
                                              Grid.Row="1" Height="35"></userControls:CustomTextInput>
            </Grid>
            
        </GroupBox>
    </Grid>
</UserControl>
