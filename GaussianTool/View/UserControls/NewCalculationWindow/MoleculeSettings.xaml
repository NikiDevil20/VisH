<UserControl x:Class="GaussianTool.View.UserControls.NewCalculationWindow.MoleculeSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GaussianTool.View.UserControls.NewCalculationWindow"
             xmlns:userControls="clr-namespace:GaussianTool.View.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="600">
        
        
    <StackPanel >
        <GroupBox VerticalAlignment="Top" Header="Molecule Name" Margin="10" BorderBrush="#006DB3" BorderThickness="2" 
                  Padding="5">
        
            <userControls:CustomTextInput Placeholder="molecule name" Text="{Binding MoleculeName}" 
                                          Margin="5"></userControls:CustomTextInput>
        
        </GroupBox>
        
        <GroupBox VerticalAlignment="Top" Header="Coordinates" Margin="10" BorderBrush="#006DB3" BorderThickness="2" 
                  Padding="5">
            <StackPanel>
                
                <userControls:CustomTextInput Placeholder="SMILES" Text="{Binding SmilesString}" 
                                              Margin="5" Grid.Row="0"></userControls:CustomTextInput>
            
                <userControls:CustomTextInput Placeholder="Job ID" Text="{Binding JobId}" 
                                              Margin="5" Grid.Row="1"></userControls:CustomTextInput>
                
            </StackPanel>
        </GroupBox>
        
        <GroupBox VerticalAlignment="Top" Header="State and Charge" Margin="10" BorderBrush="#006DB3" BorderThickness="2" 
                  Padding="5">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                
                <ComboBox 
                    ItemsSource="{Binding States}"
                    SelectedItem="{Binding SelectedState}"
                    Margin="10, 0"
                    ></ComboBox>
                
                <ComboBox Grid.Column="1" 
                    ItemsSource="{Binding Charges}"
                    SelectedItem="{Binding SelectedCharge}"
                    Margin="10, 0"
                ></ComboBox>
            </Grid>
        </GroupBox>
    </StackPanel>
        
</UserControl>
