<Window x:Class="VisH.View.Windows.StartNewCalcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:VisH.View.Windows"
        xmlns:newCalculationWindow="clr-namespace:VisH.View.UserControls.NewCalculationWindow"
        mc:Ignorable="d"
        Title="Start New Calculation" Height="600" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#006DB3" BorderBrush="Transparent" BorderThickness="0">
            <TextBlock Text="Start New Calculation" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" 
                       VerticalAlignment="Center" Foreground="White"/>
        </Border>
        
        
        <!-- Content -->
        <TabControl Grid.Row="1" HorizontalAlignment="Stretch">
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
                </Style>
            </TabControl.Resources>

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <UniformGrid
                            Grid.Row="0"
                            Rows="1"
                            IsItemsHost="True"/>

                        <Border Grid.Row="1"
                                BorderThickness="1"
                                BorderBrush="Gray">
                            <ContentPresenter
                                ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="20, 8"></Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            
            <!-- <TabItem Header="General"> -->
            <!--      -->
            <!--      -->
            <!-- </TabItem> -->
            
            
            <TabItem Header="Molecule">
                <newCalculationWindow:MoleculeSettings></newCalculationWindow:MoleculeSettings>
                
            </TabItem>
            
            <TabItem Header="Gaussian">
                <newCalculationWindow:ParametersSettings></newCalculationWindow:ParametersSettings>
                
            </TabItem>
            
            
        </TabControl>
        
        
        <!-- Bottom -->
        <Border Grid.Row="2" Background="#006DB3">
            <Grid>
            
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            
                <Button Grid.Column="0" Background="White" FontSize="16" FontWeight="SemiBold" 
                        Margin="5, 5, 0, 5" Command="{Binding SaveTemplateCommand}" 
                        Content="Save as Template"></Button>
                <Button Grid.Column="1" Background="White" FontSize="16" FontWeight="SemiBold" 
                        Margin="5, 5, 0, 5" Command="{Binding RunCommand}" 
                        Content="Run"></Button>
                <Button Grid.Column="2" Background="White" FontSize="16" FontWeight="SemiBold" 
                        Margin="5" Command="{Binding CancelCommand}" Content="Cancel"></Button>
            </Grid>
        </Border>
        
    </Grid>
</Window>

