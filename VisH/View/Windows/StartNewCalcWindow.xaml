<Window x:Class="VisH.View.Windows.StartNewCalcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:VisH.View.Windows"
        xmlns:newCalculationWindow="clr-namespace:VisH.View.UserControls.NewCalculationWindow"
        mc:Ignorable="d"
        Title="Start New Calculation" Height="750" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#006DB3" BorderBrush="Transparent" BorderThickness="0">
            <TextBlock Text="Start New Calculation" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" 
                       VerticalAlignment="Center" Foreground="White"/>
        </Border>
        
        <newCalculationWindow:MoleculeSettings Grid.Row="1"></newCalculationWindow:MoleculeSettings>
        
        <!-- Bottom -->
        <Border Grid.Row="2" Background="#006DB3">
            <Grid>
            
                <Grid.ColumnDefinitions>
                    <!-- <ColumnDefinition Width="*"/> -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            
                <!-- <Button Grid.Column="0" Background="White" FontSize="16" FontWeight="SemiBold"  -->
                <!--         Margin="5, 5, 0, 5" Command="{Binding SaveTemplateCommand}"  -->
                <!--         Content="Save as Template"></Button> -->
                <Button Grid.Column="0" Background="White" FontSize="16" FontWeight="SemiBold" 
                        Margin="5, 5, 0, 5" Command="{Binding RunCommand}" 
                        Content="Run"></Button>
                <Button Grid.Column="1" Background="White" FontSize="16" FontWeight="SemiBold" 
                        Margin="5" Command="{Binding CancelCommand}" Content="Cancel"></Button>
            </Grid>
        </Border>
        
    </Grid>
</Window>
