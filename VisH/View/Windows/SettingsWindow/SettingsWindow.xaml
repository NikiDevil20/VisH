<Window x:Class="VisH.View.Windows.SettingsWindow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:VisH.View.Windows.SettingsWindow"
        mc:Ignorable="d"
        Title="Settings"
        Height="520"
        Width="900"
        MinHeight="450"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#414B57" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#27313B" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="#FFF4D6"
                BorderBrush="#E5C76B"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14"
                Margin="0,0,0,18"
                Visibility="{Binding HasStartupMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding StartupMessage}" FontWeight="SemiBold" Foreground="#624B00" TextWrapping="Wrap" />
                <TextBlock Text="Restart the application after entering a correct configuration." Margin="0,5,0,0" Foreground="#624B00" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Padding="18" Background="White" BorderBrush="#DCE2E8" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Saved configurations" Style="{StaticResource PanelHeaderStyle}" />
                <TextBlock Grid.Row="1" Text="Select a configuration to edit" Margin="0,6,0,16" Foreground="#77818C" TextWrapping="Wrap" />
                <ListBox Grid.Row="2" ItemsSource="{Binding SavedConfigurations}" SelectedItem="{Binding SelectedConfiguration, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Padding="8,10" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Padding="24" Background="White" BorderBrush="#DCE2E8" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Configuration" Style="{StaticResource PanelHeaderStyle}" />
                <TextBlock Grid.Row="1" Text="Connection and working-directory settings" Margin="0,6,0,22" Foreground="#77818C" />

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Configuration name" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Row="1" Style="{StaticResource FieldTextBoxStyle}" Text="{Binding ConfigurationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Text="Rechnungen directory" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Grid.Row="3" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,8,0" Text="{Binding WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Browse..." Padding="14,0" Height="34" Command="{Binding BrowseDirectoryCommand}" CommandParameter="{Binding}" />
                    </Grid>
                    <TextBlock Grid.Row="4" Text="Cluster username" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Row="5" Style="{StaticResource FieldTextBoxStyle}" Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="6" Text="SSH key file" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Grid.Row="7" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,8,0" Text="{Binding SshKeyFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Browse..." Padding="14,0" Height="34" Command="{Binding BrowseSshKeyCommand}" CommandParameter="{Binding}" />
                    </Grid>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Apply Configuration"
                            Padding="20,9"
                            Margin="0,0,10,0"
                            Command="{Binding ApplyConfigurationCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="Save configuration"
                            Padding="20,9"
                            Background="#006DB3"
                            Foreground="White"
                            BorderBrush="#006DB3"
                            Command="{Binding SaveConfigurationCommand}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
