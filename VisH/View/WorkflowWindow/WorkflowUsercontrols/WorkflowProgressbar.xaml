<UserControl x:Class="VisH.View.WorkflowWindow.WorkflowUsercontrols.WorkflowProgressbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VisH.View.WorkflowWindow.WorkflowUsercontrols"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Column="0" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" 
                Height="10" Background="{Binding SelectWorkflowIndicator}" Margin="5"
                CornerRadius="5"></Border>
        <Border Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" 
                Height="10" Background="{Binding ChooseMoleculeIndicator}" Margin="5"
                CornerRadius="5"></Border>
        <Border Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" 
                Height="10" Background="{Binding MoleculeSettingsIndicator}" Margin="5"
                CornerRadius="5"></Border>
        <Border Grid.Column="3" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" 
                Height="10" Background="{Binding MethodSettingsIndicator}" Margin="5"
                CornerRadius="5"></Border>
        <Border Grid.Column="4" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" 
                Height="10" Background="{Binding OverviewIndicator}" Margin="5"
                CornerRadius="5"></Border>
            
        <Label Grid.Column="0" Grid.Row="1" Content="Select Workflow" Margin="5, 2" VerticalAlignment="Top" 
            HorizontalAlignment="Left" Foreground="{StaticResource PrimaryBlueBrush}"
            FontSize="14" FontWeight="Bold"></Label>
        <Label Grid.Column="1" Grid.Row="1" Content="Choose Molecule" Margin="5, 2" VerticalAlignment="Top" 
        HorizontalAlignment="Left" Foreground="{StaticResource PrimaryBlueBrush}"
        FontSize="14" FontWeight="Bold"></Label>
        <Label Grid.Column="2" Grid.Row="1" Content="Molecule Settings" Margin="5, 2" VerticalAlignment="Top" 
        HorizontalAlignment="Left" Foreground="{StaticResource PrimaryBlueBrush}"
        FontSize="14" FontWeight="Bold"></Label>
        <Label Grid.Column="3" Grid.Row="1" Content="Method Settings" Margin="5, 2" VerticalAlignment="Top" 
        HorizontalAlignment="Left" Foreground="{StaticResource PrimaryBlueBrush}"
        FontSize="14" FontWeight="Bold"></Label>
        <Label Grid.Column="4" Grid.Row="1" Content="Overview" Margin="5, 2" VerticalAlignment="Top" 
        HorizontalAlignment="Left" Foreground="{StaticResource PrimaryBlueBrush}"
        FontSize="14" FontWeight="Bold"></Label>
        
    </Grid>
</UserControl>
