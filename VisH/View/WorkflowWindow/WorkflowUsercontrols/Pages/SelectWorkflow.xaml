<UserControl x:Class="VisH.View.WorkflowWindow.WorkflowUsercontrols.Pages.SelectWorkflow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VisH.View.WorkflowWindow.WorkflowUsercontrols.Pages"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Label Content="Select a workflow:"
               Grid.Row="0"
               FontWeight="Bold"
               FontSize="36"
               Foreground="{StaticResource PrimaryBlueBrush}"
               Padding="10"></Label>
        
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- <Grid.ColumnDefinitions> -->
            <!--     <ColumnDefinition Width="*"/> -->
            <!--     <ColumnDefinition Width="*"/> -->
            <!--     <ColumnDefinition Width="*"/> -->
            <!-- </Grid.ColumnDefinitions> -->
            
            <RadioButton Grid.Row="0"
                         Grid.Column="0"
                         Content="Fluorescence" 
                         GroupName="WorkflowSelection"
                         IsChecked="{Binding IsFluorescenceSelected, Mode=TwoWay}"
                         Style="{StaticResource CardRadioStyle}"/>
        
            <RadioButton Grid.Row="1" 
                         Grid.Column="0"
                         Content="Electron Affinity" 
                         GroupName="WorkflowSelection"
                         IsChecked="{Binding IsElectronAffinitySelected, Mode=TwoWay}"
                         Style="{StaticResource CardRadioStyle}"/>
            
            
            
        </Grid>
        
        
        
    </Grid>
</UserControl>
