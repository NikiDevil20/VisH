<Window x:Class="VisH.View.WorkflowWindow.NewWorkflowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:VisH.View.WorkflowWindow"
        xmlns:customUsercontrols="clr-namespace:VisH.View.WorkflowWindow.WorkflowUsercontrols"
        xmlns:pages="clr-namespace:VisH.View.WorkflowWindow.WorkflowUsercontrols.Pages"
        xmlns:fluorescencePages="clr-namespace:VisH.View.WorkflowWindow.WorkflowUsercontrols.Pages.PagesForFluorescence"
        xmlns:electronAffinityPages="clr-namespace:VisH.View.WorkflowWindow.WorkflowUsercontrols.Pages.PagesForElectronAffinity"
        mc:Ignorable="d"
        Title="New Workflow" Height="450" Width="800">
    <Grid>
        <Grid.Resources>
            <fluorescencePages:FluorescenceMoleculeSettings x:Key="FluorescenceMoleculeSettingsPage"/>
            <fluorescencePages:FluorescenceMethodSettings x:Key="FluorescenceMethodSettingsPage"/>
            <fluorescencePages:FluorescenceOverview x:Key="FluorescenceOverviewPage"/>
            <electronAffinityPages:ElectronAffinityMoleculeSettings x:Key="ElectronAffinityMoleculeSettingsPage"/>
            <electronAffinityPages:ElectronAffinityMethodSettings x:Key="ElectronAffinityMethodSettingsPage"/>
            <electronAffinityPages:ElectronAffinityOverview x:Key="ElectronAffinityOverviewPage"/>
            <pages:MoleculeSettings x:Key="MoleculeSettingsPage"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>
        
        <customUsercontrols:WorkflowProgressbar Grid.Row="0"
                                                ></customUsercontrols:WorkflowProgressbar>
        
        <ContentControl Grid.Row="1">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Content">
                        <Setter.Value>
                            <pages:SelectWorkflow />
                        </Setter.Value>
                    </Setter>
                    
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WorkflowProgress}" Value="1">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <pages:SelectMolecules />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        
                        <DataTrigger Binding="{Binding WorkflowProgress}" Value="2">
                            <Setter Property="Content" Value="{StaticResource MoleculeSettingsPage}"/>
                        </DataTrigger>
                        
                        <DataTrigger Binding="{Binding WorkflowProgress}" Value="3">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <pages:MethodSettings />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WorkflowProgress}" Value="4">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <pages:WorkflowOverwiev />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding WorkflowProgress}" Value="2"/>
                                <Condition Binding="{Binding IsFluorescenceSelected}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Content" Value="{StaticResource FluorescenceMoleculeSettingsPage}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding WorkflowProgress}" Value="2"/>
                                <Condition Binding="{Binding IsElectronAffinitySelected}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Content" Value="{StaticResource ElectronAffinityMoleculeSettingsPage}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding WorkflowProgress}" Value="3"/>
                                <Condition Binding="{Binding IsFluorescenceSelected}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Content" Value="{StaticResource FluorescenceMethodSettingsPage}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding WorkflowProgress}" Value="3"/>
                                <Condition Binding="{Binding IsElectronAffinitySelected}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Content" Value="{StaticResource ElectronAffinityMethodSettingsPage}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding WorkflowProgress}" Value="4"/>
                                <Condition Binding="{Binding IsFluorescenceSelected}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Content" Value="{StaticResource FluorescenceOverviewPage}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding WorkflowProgress}" Value="4"/>
                                <Condition Binding="{Binding IsElectronAffinitySelected}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Content" Value="{StaticResource ElectronAffinityOverviewPage}"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
        
        
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Height="35"
                    Margin="10,0, 10, 5"
                    Command="{Binding BackButtonCommand}">Back</Button>
            <Button Width="100"
                    Height="35"
                    Margin="0,0, 10, 5"
                    Command="{Binding NextButtonCommand}">Next</Button>
                    
        </StackPanel>
        
    </Grid>
</Window>
